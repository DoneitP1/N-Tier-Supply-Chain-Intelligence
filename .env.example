# N-Tier Supply Chain Intelligence - Environment Configuration
# Copy this to .env and fill in the secrets.

# --- Databases ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/ntier

REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- LLM APIs ---
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIzaSy...

# --- Application Security ---
# Change these in production!
APP_API_KEY=dev_key_only
SECRET_KEY=dev_secret_only
ALGORITHM=HS256

# --- Logic Configuration ---
GRAPH_MAX_NODES=200
RISK_SIMULATION_DEPTH=5
RATE_LIMIT_ENABLED=True
COOKIE_SECURE=False
