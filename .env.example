# N-Tier Supply Chain Intelligence - Environment Configuration

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# PostgreSQL Database
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/ntier

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM APIs
ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_API_KEY=your_google_key_here

# Application Security
# IMPORTANT: Change these for production!
APP_API_KEY=generate_a_secure_app_key
SECRET_KEY=generate_a_secure_random_secret_key_for_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GRAFANA_PASSWORD=admin_password_change_me

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
